# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/workspace_manager?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Optional: trust host in production (Vercel sets AUTH_URL automatically when configured)
# AUTH_TRUST_HOST=true
